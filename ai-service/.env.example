# Defaults need no configuration, accounts, or provider credentials.
# Data defaults to ~/.cv-tailor; --data-dir overrides it.
# CV_TAILOR_HOME=/path/to/workspace
AI_MODE=external
EXECUTION_BACKEND=local
ENVIRONMENT=development
# Optional API AI: pip install -e "ai-service[ai]"
# Put credentials in ~/.cv-tailor/.env, then explicitly set AI_MODE=api.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# JEV_API_KEY=
